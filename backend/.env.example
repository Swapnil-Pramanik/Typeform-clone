# Local development — a plain SQLite file next to the backend
DATABASE_URL=sqlite:///./typeform.db

# Production — hosted libSQL (Turso). Two values, exactly as Turso issues them.
# The dashboard shows libsql://; SQLAlchemy needs the sqlite+libsql:// scheme.
# DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io?secure=true
# DATABASE_AUTH_TOKEN=<token>

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
