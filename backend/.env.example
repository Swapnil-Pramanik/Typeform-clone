# Local development — a plain SQLite file next to the backend
DATABASE_URL=sqlite:///./typeform.db

# Production — hosted libSQL (Turso). Same dialect family, so models and
# migrations are byte-identical to local.
# DATABASE_URL=sqlite+libsql://<db-name>-<org>.turso.io?authToken=<token>&secure=true

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
